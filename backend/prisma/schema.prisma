generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  username  String?  @unique
  bio       String?
  avatar    String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  posts     Post[]
  stories   Story[]
  reels     Reel[]
  reelLikes ReelLike[]
  savedReels SavedReel[]
  bookings  Booking[]
  conversations Conversation[]
  messages      Message[]
}

model Post {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  imageUrl  String
  caption   String?
  location  String?
  itinerary Json?
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
}

model Reel {
  id             BigInt    @id @default(autoincrement())
  title          String?
  place          String?
  video_url      String?
  image_url      String?
  rating         Float?    @db.Real
  seats          Int?
  price          Int?
  duration       String?
  highlights     Json?
  itinerary_days Json?
  stay           Json?
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  authorId       Int?
  author         User?     @relation(fields: [authorId], references: [id])
  likes          ReelLike[]
  savedBy        SavedReel[]
  bookings       Booking[]

  @@map("reels")
}

model ReelLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  reelId    BigInt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId])
}

model SavedReel {
  id        Int      @id @default(autoincrement())
  userId    Int
  reelId    BigInt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId])
}

model Booking {
  id           Int      @id @default(autoincrement())
  userId       Int
  reelId       BigInt
  bookingDate  DateTime
  guests       Int
  totalPrice   Float
  status       String   @default("CONFIRMED") // CONFIRMED, CANCELLED
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
}

model Story {
  id        Int      @id @default(autoincrement())
  userId    Int
  imageUrl  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model Conversation {
  id            Int       @id @default(autoincrement())
  participants  User[]
  messages      Message[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Message {
  id             Int          @id @default(autoincrement())
  text           String
  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id])
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}
