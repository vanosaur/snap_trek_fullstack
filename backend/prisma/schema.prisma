generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  imageUrl  String
  caption   String?
  location  String?
  itinerary Json?
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
}

model Reel {
  id             Int      @id @default(autoincrement())
  title          String
  place          String?
  video_url      String
  image_url      String?
  rating         Float?
  seats          Int?
  price          Int?
  duration       String?
  highlights     Json?
  itinerary_days Json?
  stay           Json?
  createdAt      DateTime @default(now())

  @@map("reels")
}

